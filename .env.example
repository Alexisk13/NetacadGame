# Supabase project settings (Project Settings > API).
# Both values are public by design: data is protected by Row Level Security.
# Leave them empty to run in local mode (no login, progress saved in this browser only).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
