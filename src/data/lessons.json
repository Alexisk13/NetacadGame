    {"k": "mcq", "q": "Kas ietekmē caurlaidspēju (throughput)?", "o": ["Trafika apjoms, trafika tips, latentums", "Tikai kabeļa krāsa", "Tikai kategorija", "Nekas, tā vienmēr = joslas platums"], "a": 0}
  ]},
  {"t": 3, "steps": [
