    {"k": "mcq", "q": "Kāpēc komutatoram vajag ip default-gateway?", "o": ["Lai to varētu pārvaldīt no cita tīkla", "Lai tas maršrutētu paketes", "Lai darbotos MAC tabula", "Lai ieslēgtu portus"], "a": 0}
  ]},
  {"t": 11, "steps": [
    {"k": "info", "h": "TCP = uzticamais", "t": "4. slānis, PDU = segments. 4 īpašības:", "b": ["Sesijas izveide", "Uzticama piegāde (ACK, atkārtošana)", "Piegāde pareizā secībā", "Plūsmas kontrole"]},
    {"k": "info", "h": "Galvene: 20 B, 10 lauki", "t": "Source Port, Destination Port, Sequence, Acknowledgment, Header Length, Reserved, Control Bits, Window, Checksum, Urgent (+ Options).", "tip": "Karogi: URG ACK PSH RST SYN FIN"},
    {"k": "flow", "h": "Trīsvirzienu rokasspiediens", "actors": ["Klients", "Serveris"], "steps": [{"f": 0, "to": 1, "m": "SYN", "n": "seq = ISN (nejaušs)"}, {"f": 1, "to": 0, "m": "SYN, ACK"}, {"f": 0, "to": 1, "m": "ACK", "n": "Sesija atvērta"}]},
    {"k": "flow", "h": "Sesijas beigšana (4 soļi)", "actors": ["Klients", "Serveris"], "steps": [{"f": 0, "to": 1, "m": "FIN"}, {"f": 1, "to": 0, "m": "ACK"}, {"f": 1, "to": 0, "m": "FIN"}, {"f": 0, "to": 1, "m": "ACK"}]},
    {"k": "info", "h": "Uzticamība un plūsma", "b": ["Seq pieaug par nosūtīto baitu skaitu", "SACK: atkārto tikai pazudušos segmentus", "Window: cik baitu var sūtīt bez ACK", "MSS = 1500 MTU - 20 IP - 20 TCP = 1460 B"]},
    {"k": "mcq", "q": "No 10 segmentiem pazūd 3. un 4. Ko atkārto ar SACK?", "o": ["Tikai 3. un 4.", "No 3. līdz 10.", "Visus 10", "Neko"], "a": 0},
    {"k": "mcq", "q": "Kāpēc MSS ir 1460 B?", "o": ["1500 - 20 - 20", "1518 - 58", "Tā nolēma IETF bez iemesla", "1460 = 2^10 + 436"], "a": 0},
    {"k": "info", "h": "Porti", "tbl": [["Diapazons", "Nosaukums"], ["0-1023", "Labi zināmie"], ["1024-49151", "Reģistrētie"], ["49152-65535", "Dinamiskie"]], "t": "Ligzda (socket) = IP + ports. Klients 49152 → serveris 443."},
    {"k": "match", "q": "Savieno portu ar protokolu", "pairs": [["22", "SSH"], ["23", "Telnet"], ["25", "SMTP"], ["80", "HTTP"], ["443", "HTTPS"]]},
    {"k": "mcq", "q": "Kāpēc ISN ir nejaušs?", "o": ["Pret uzbrukumiem", "Lai būtu ātrāk", "Tā prasa Ethernet", "Lai taupītu portus"], "a": 0}
  ]},
  {"t": 12, "steps": [
    {"k": "info", "h": "UDP = vieglais", "t": "4. slānis, PDU = datagramma, best effort. Ko UDP NEDARA:", "b": ["Nav sesijas", "Nav ACK un atkārtošanas", "Nav secības", "Nav plūsmas kontroles"]},
    {"k": "sort", "q": "TCP vai UDP?", "buckets": ["TCP", "UDP"], "items": [["3-way rokasspiediens", 0], ["8 B galvene", 1], ["20 B galvene", 0], ["Datagramma", 1], ["Window plūsmas kontrole", 0], ["VoIP", 1], ["HTTPS", 0], ["DHCP", 1]]},
    {"k": "info", "h": "Galvene: 8 B, 4 lauki", "t": "Source Port (16), Destination Port (16), Length (16, galvene + dati), Checksum (16)."},
    {"k": "match", "q": "UDP porti", "pairs": [["53", "DNS"], ["67", "DHCP serveris"], ["68", "DHCP klients"], ["69", "TFTP"], ["161", "SNMP"]]},
