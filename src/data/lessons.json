    {"k": "match", "q": "Savieno tehnoloģiju ar IEEE standartu", "pairs": [["Bluetooth", "802.15"], ["Wi-Fi", "802.11"], ["WiMAX", "802.16"], ["Zigbee (IoT)", "802.15.4"]]},
    {"k": "info", "h": "802.11 standarti", "tbl": [["Std.", "Ātrums", "GHz"], ["802.11", "2 Mb/s", "2,4"], ["a", "54 Mb/s", "5"], ["b", "11 Mb/s", "2,4"], ["g", "54 Mb/s", "2,4"], ["n", "600 Mb/s", "2,4 un 5"], ["ac", "1,3 Gb/s", "5"], ["ad", "7 Gb/s", "2,4, 5 un 60"]], "t": "2,4 GHz iet tālāk un caur sienām, 5 GHz ir ātrāks ar mazāku rādiusu. ax = Wi-Fi 6."},
    {"k": "match", "q": "Savieno standartu ar ātrumu", "pairs": [["802.11b", "11 Mb/s"], ["802.11a", "54 Mb/s, 5 GHz"], ["802.11n", "600 Mb/s"], ["802.11ac", "1,3 Gb/s"], ["802.11ad", "7 Gb/s"]]},
    {"k": "mcq", "q": "Kuri 2,4 GHz kanāli nepārklājas?", "o": ["1, 6, 11", "1, 2, 3", "1, 5, 9", "6, 12, 13"], "a": 0},
