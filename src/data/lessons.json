  ]},
  {"t": 9, "steps": [
    {"k": "info", "h": "Kāpēc IPv6?", "t": "IPv4 adreses beidzās. IPv6 ir 128 biti: katram hostam pietiek publisko adrešu, tāpēc NAT nevajag.", "b": ["8 hekseti pa 16 bitiem, atdalīti ar kolu", "Nav apraides (broadcast)"]},
    {"k": "info", "h": "Galvene: 40 B fiksēti", "t": "8 lauki: Version (0110), Traffic Class, Flow Label, Payload Length, Next Header, Hop Limit, Source, Destination. Nav kontrolsummas, maršrutētāji nefragmentē."},
    {"k": "match", "q": "Kurš IPv6 lauks atbilst IPv4 laukam?", "pairs": [["Hop Limit", "TTL"], ["Next Header", "Protocol"], ["Traffic Class", "DS"]]},
    {"k": "info", "h": "Saīsināšana", "b": ["1) Izlaid sākuma nulles katrā hekstetā: 0db8 → db8", "2) :: aizstāj nulles heksetu virkni, bet tikai VIENREIZ"], "t": "2001:0db8:0000:1111:0000:0000:0000:0200 → 2001:db8:0:1111::200"},
    {"k": "widget", "w": "ipv6", "h": "Saīsini adreses"},
    {"k": "info", "h": "Adrešu tipi", "tbl": [["Tips", "Prefikss"], ["GUA (publiskā)", "2000::/3"], ["LLA (saitē)", "fe80::/10"], ["ULA (privātā)", "fc00::/7"], ["Loopback", "::1"], ["Multicast", "ff00::/8"]], "t": "GUA = 48 b globālais prefikss + 16 b apakštīkla ID + 64 b interfeisa ID."},
    {"k": "match", "q": "Savieno tipu ar prefiksu", "pairs": [["GUA", "2000::/3"], ["LLA", "fe80::/10"], ["ULA", "fc00::/7"], ["Multicast", "ff00::/8"]]},
    {"k": "mcq", "q": "Kas IPv6 aizstāj apraidi?", "o": ["Multicast, piem. ff02::1", "Anycast", "Loopback", "LLA"], "a": 0},
    {"k": "flow", "h": "SLAAC soli pa solim", "actors": ["Hosts", "Maršrutētājs"], "steps": [{"f": 0, "to": 1, "m": "RS", "n": "Router Solicitation uz ff02::2"}, {"f": 1, "to": 0, "m": "RA", "n": "Prefikss, vārteja = maršrutētāja LLA"}, {"f": 0, "to": 0, "m": "Izveido GUA", "n": "Prefikss + EUI-64 vai nejaušs ID"}, {"f": 0, "to": 0, "m": "DAD", "n": "NS: vai adrese brīva?"}]},
    {"k": "mcq", "q": "EUI-64 no MAC FC:99:47:75:CE:E0 = ?", "o": ["FE99:47FF:FE75:CEE0", "FC99:47FF:FE75:CEE0", "FE99:4775:FFFE:CEE0", "FC99:4775:CEE0:FFFE"], "a": 0, "e": "Vidū ieliek FFFE un apgriež 7. bitu: FC → FE."},
    {"k": "mcq", "q": "Kuru pārejas metodi iesaka Cisco?", "o": ["Dual stack", "Tunelēšana", "NAT64", "APIPA"], "a": 0}
  ]},
  {"t": 10, "steps": [
