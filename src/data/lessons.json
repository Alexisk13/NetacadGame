    {"k": "match", "q": "Ko nozīmē kods?", "pairs": [["C", "Tieši pievienots tīkls"], ["L", "Interfeisa IP"], ["S", "Statiskais maršruts"], ["O", "OSPF"], ["D", "EIGRP"]]},
    {"k": "info", "h": "Garākā atbilstība", "t": "Ja galamērķim der vairāki maršruti, uzvar garākais prefikss (longest match). Ja prefiksi vienādi, uzvar mazākā metrika."},
    {"k": "mcq", "q": "Uz 172.16.0.10 der /12, /18 un /26. Kuru izvēlas?", "o": ["/26", "/12", "/18", "Nejauši"], "a": 0},
    {"k": "sort", "q": "Statiskā vai dinamiskā?", "buckets": ["Statiskā", "Dinamiskā"], "items": [["Konfigurē manuāli", 0], ["Pielāgojas izmaiņām pati", 1], ["Netērē CPU un joslu", 0], ["Lieliem tīkliem", 1], ["Maršruts uz ISP", 0], ["OSPF, EIGRP", 1]]},
    {"k": "match", "q": "Savieno protokolu", "pairs": [["OSPF", "Atvērts standarts, link-state"], ["EIGRP", "Cisco"], ["BGP", "Starp ISP"]]},
