    {"k": "mcq", "q": "MikroTik: lai Wi-Fi interfeiss darbotos kā piekļuves punkts, Mode = ?", "o": ["ap bridge", "station", "bridge only", "monitor"], "a": 0, "e": "Security Profile: WPA/WPA2 PSK, dynamic keys."}
  ]},
  {"t": 5, "steps": [
