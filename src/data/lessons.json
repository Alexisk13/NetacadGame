    {"k": "info", "h": "Galvene: 20 B", "tbl": [["Lauks", "Nozīme"], ["Version", "0100 = 4"], ["DS", "QoS prioritāte"], ["TTL", "-1 katrā maršrutētājā"], ["Protocol", "1 ICMP, 6 TCP, 17 UDP"], ["Header Checksum", "Galvenes pārbaude"], ["Source / Dest IP", "32 + 32 biti"]]},
    {"k": "match", "q": "Savieno lauku ar nozīmi", "pairs": [["TTL", "Mīnus 1 katrā lēcienā"], ["Protocol", "6 = TCP, 17 = UDP"], ["Version", "0100"], ["Total Length", "Visas paketes garums"]]},
    {"k": "mcq", "q": "Kas notiek, kad TTL = 0?", "o": ["Pakete atmesta, avotam ICMP Time Exceeded", "Pakete iet uz noklusējuma maršrutu", "TTL atjauno uz 255", "Pakete fragmentējas"], "a": 0},
