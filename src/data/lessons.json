    {"k": "match", "q": "Kas tā par adresi?", "pairs": [["10.5.5.5", "Privātā"], ["127.0.0.1", "Loopback"], ["169.254.3.7", "APIPA (nav DHCP)"], ["224.0.0.5", "Multicast (OSPF)"]]},
