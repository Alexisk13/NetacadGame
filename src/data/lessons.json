    {"k": "sort", "q": "POP3 vai IMAP?", "buckets": ["POP3", "IMAP"], "items": [["Lejupielādē un dzēš no servera", 0], ["Kopija paliek serverī", 1], ["Ērti vairākām ierīcēm", 1], ["Ports 110", 0], ["Ports 143", 1]]},
    {"k": "flow", "h": "DHCP DORA", "actors": ["Klients", "DHCP serveris"], "steps": [{"f": 0, "to": 1, "m": "DHCPDISCOVER", "n": "Apraide: meklē serveri"}, {"f": 1, "to": 0, "m": "DHCPOFFER", "n": "Piedāvā adresi"}, {"f": 0, "to": 1, "m": "DHCPREQUEST", "n": "Apraide: izvēlas serveri"}, {"f": 1, "to": 0, "m": "DHCPACK", "n": "Apstiprina nomu (lease)"}]},
